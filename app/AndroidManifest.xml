<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tadaoyamaoka.vocalpitchmonitor"
    android:versionCode="4"
    android:versionName="4.0">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.tadaoyamaoka.vocalpitchmonitor.MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.tadaoyamaoka.vocalpitchmonitor.SettingsActivity"
            android:label="@string/settings_name"
            android:theme="@style/AppTheme.Settings" />
        <activity
            android:name="com.tadaoyamaoka.vocalpitchmonitor.LoadActivity"
            android:label="@string/action_load"
            android:theme="@style/AppTheme.Settings" />
    </application>
</manifest>
